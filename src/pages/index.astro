---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SaturdayEvents from '../components/SaturdayEvents.astro';
import SantaSpots from '../components/SantaSpots.astro';
import WindowContest from '../components/WindowContest.astro';
import VolunteerCallout from '../components/VolunteerCallout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getVisibleEvents } from '../lib/events';
import { settings, isVolunteerCalloutVisible } from '../lib/settings';

const title = 'Downtown Independence Holidays 2026';
const dateline = 'Every Saturday, Nov 28 to Dec 19';
const description =
  'Holiday events every Saturday from Nov 28 to Dec 19 in downtown Independence, plus Santa photo spots and the Storefront Window Display Contest.';

const events = await getVisibleEvents();
const santaSpots = settings.santaPhotoSpots;
const showVolunteerCallout = isVolunteerCalloutVisible(settings.volunteerCallout);
---

<BaseLayout title={title} description={description}>
  <Hero title={title} dateline={dateline} />

  <main id="main">
    <Section id="events" eyebrow="What is happening" title="Saturday events">
      <SaturdayEvents events={events} />
    </Section>

    {
      santaSpots.length > 0 && (
        <Section
          id="santa"
          eyebrow="Bring the kids"
          title="Santa photo spots"
          tone="panel"
        >
          <SantaSpots spots={santaSpots} />
        </Section>
      )
    }

    <Section
      id="window-contest"
      eyebrow="Vote for your favorite"
      title="Storefront Window Display Contest"
    >
      <WindowContest settings={settings} />
    </Section>

    {
      showVolunteerCallout && settings.volunteerCallout && (
        <Section id="volunteer" eyebrow="Lend a hand" title="Volunteers wanted" tone="panel">
          <VolunteerCallout callout={settings.volunteerCallout} />
        </Section>
      )
    }

    <NewsletterSignup />
  </main>

  <SiteFooter />
</BaseLayout>
