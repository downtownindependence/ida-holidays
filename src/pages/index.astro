---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import EventList from '../components/EventList.astro';
import SantaSpots from '../components/SantaSpots.astro';
import WindowContest from '../components/WindowContest.astro';
import VoteBanner from '../components/VoteBanner.astro';
import VolunteerCallout from '../components/VolunteerCallout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getVisibleEvents, groupEventsByDay } from '../lib/events';
import { formatWeekday } from '../lib/format';
import { settings, isVolunteerCalloutVisible } from '../lib/settings';

const title = 'Season of Lights | Downtown Independence';
const description =
  'Holiday events every Saturday from Nov 28 to Dec 19 in downtown Independence, Oregon, plus the Holiday Window Display Contest. Vote for your favorite window!';

const eventDays = groupEventsByDay(await getVisibleEvents());
const santaSpots = settings.santaPhotoSpots;
const showVolunteerCallout = isVolunteerCalloutVisible(settings.volunteerCallout);

// "Upcoming Saturdays" once every date shown is a Saturday (after the Nov 16
// meeting drops off), so it's clear these all happen on Saturdays.
const allSaturdays =
  eventDays.length > 0 && eventDays.every((day) => formatWeekday(day.date) === 'Saturday');
const eventsTitle = allSaturdays ? 'Upcoming Saturdays' : 'Upcoming events';

// The flyer's QR code opens this page. While voting is open, the ballot comes
// first, right under the headline, and the events follow it.
const votingFirst = settings.contestStage === 'voting-open';
---

<BaseLayout title={title} description={description}>
  <Hero
    datelineTop="Every Saturday"
    datelineFrom="Nov 28"
    datelineTo="Dec 19"
    compact={votingFirst}
  />

  <VoteBanner settings={settings} />

  <main id="main">
    {
      votingFirst && (
        <Section
          id="window-contest"
          eyebrow="Vote for your favorite"
          title="Holiday Window Display Contest"
          tone="panel"
        >
          <WindowContest settings={settings} />
        </Section>
      )
    }

    <Section id="events" eyebrow="Mark your calendar" title={eventsTitle} wide framed>
      <EventList days={eventDays} />
    </Section>

    {
      !votingFirst && (
        <Section
          id="window-contest"
          eyebrow="Vote for your favorite"
          title="Holiday Window Display Contest"
          tone="panel"
        >
          <WindowContest settings={settings} />
        </Section>
      )
    }

    {
      santaSpots.length > 0 && (
        <Section id="santa" eyebrow="Bring the kids" title="Santa photo spots">
          <SantaSpots spots={santaSpots} />
        </Section>
      )
    }

    {
      showVolunteerCallout && settings.volunteerCallout && (
        <Section id="volunteer" eyebrow="Lend a hand" title="Volunteers wanted" tone="panel">
          <VolunteerCallout callout={settings.volunteerCallout} />
        </Section>
      )
    }

    <NewsletterSignup />
  </main>

  <SiteFooter />
</BaseLayout>
