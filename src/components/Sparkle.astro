---
/* The small gold starburst the flyer uses between events on the same day. */
const rays = Array.from({ length: 8 }, (_, index) => index * 22.5);
---

<svg class="sparkle" viewBox="0 0 40 40" aria-hidden="true">
  {
    rays.map((angle, index) => (
      <line
        x1="20"
        y1={index % 2 === 0 ? 1 : 6}
        x2="20"
        y2={index % 2 === 0 ? 39 : 34}
        transform={`rotate(${angle} 20 20)`}
      />
    ))
  }
</svg>

<style>
  .sparkle {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline: auto;
    stroke: var(--color-sparkle);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
</style>
