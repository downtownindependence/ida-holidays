---
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  tone?: 'plain' | 'panel';
}

const { id, title, eyebrow, tone = 'plain' } = Astro.props;
const headingId = title ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['section', tone === 'panel' && 'section--panel']}
  aria-labelledby={headingId}
>
  <div class="section__inner">
    {
      title && (
        <header class="section__header">
          {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
    padding-inline: var(--page-gutter);
  }

  .section--panel {
    background: var(--color-surface-strong);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  .section__inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .section__header {
    margin-bottom: var(--space-8);
  }

  .section__eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .section__header h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }
</style>
