---
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  tone?: 'plain' | 'panel';
  /** Let the content run wider, for the side-by-side event columns. */
  wide?: boolean;
  /** Draw a thin cream frame with the heading set into its top line, like the flyer. */
  framed?: boolean;
}

const { id, title, eyebrow, tone = 'plain', wide = false, framed = false } = Astro.props;
const headingId = title ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['section', tone === 'panel' && 'section--panel']}
  aria-labelledby={headingId}
>
  <div
    class:list={[
      'section__inner',
      wide && 'section__inner--wide',
      framed && 'section__inner--framed',
    ]}
  >
    {
      title && (
        <header class="section__header">
          {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
    padding-inline: var(--page-gutter);
  }

  .section--panel {
    background: var(--color-bg-deep);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  .section__inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .section__inner--wide {
    max-width: var(--wide-max);
  }

  .section__header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  /* The flyer's thin cream frame around the events, with the heading sitting
   * in a gap in the top line. */
  .section__inner--framed {
    border: 1.5px solid var(--color-frame);
    padding: 0 var(--space-4) var(--space-10);
  }

  .section__inner--framed > .section__header {
    width: fit-content;
    max-width: calc(100% - var(--space-8));
    /* The negative bottom margin takes back the space left by pulling the
     * heading up onto the line. */
    margin: 0 auto calc(var(--space-6) - 2.25rem);
    padding-inline: var(--space-4);
    background: var(--color-bg);
    /* Pull the heading up so the frame's top line runs through its middle. */
    translate: 0 -50%;
  }

  .section--panel .section__inner--framed > .section__header {
    background: var(--color-bg-deep);
  }

  @media (min-width: 40rem) {
    .section__inner--framed {
      padding-inline: var(--space-8);
    }
  }

  .section__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .section__header h2 {
    margin: 0;
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }
</style>
