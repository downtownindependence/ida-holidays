---
interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  tone?: 'plain' | 'panel';
  /** Let the content run wider, for the side-by-side event columns. */
  wide?: boolean;
}

const { id, title, eyebrow, tone = 'plain', wide = false } = Astro.props;
const headingId = title ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['section', tone === 'panel' && 'section--panel']}
  aria-labelledby={headingId}
>
  <div class:list={['section__inner', wide && 'section__inner--wide']}>
    {
      title && (
        <header class="section__header">
          {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
          <h2 id={headingId}>{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
    padding-inline: var(--page-gutter);
  }

  .section--panel {
    background: var(--color-bg-deep);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  .section__inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .section__inner--wide {
    max-width: var(--wide-max);
  }

  .section__header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .section__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .section__header h2 {
    margin: 0;
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }
</style>
