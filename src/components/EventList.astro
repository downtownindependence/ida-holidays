---
/*
 * Events laid out like the flyer: each day gets a cream sun circle for the
 * date with that day's events underneath, separated by small gold sparkles.
 *
 *   Phone          One day after another, with a sparkle on the line between days
 *   Half screen    One row per day: date circle on the left, events on the right
 *   Full screen    Days side by side in columns, like the flyer
 */
import type { EventDay } from '../lib/events';
import { clockParts, formatWeekday, splitLinkingWords } from '../lib/format';
import SunDate from './SunDate.astro';
import Sparkle from './Sparkle.astro';
import EventIcon from './EventIcon.astro';

interface Props {
  days: EventDay[];
}

const { days } = Astro.props;
// Full screen: up to five days fit in one row (the flyer has four Saturdays,
// plus the November meeting until it passes). With more than five, rows of four.
const wideColumns = days.length <= 5 ? Math.max(days.length, 1) : 4;
---

{
  days.length === 0 ? (
    <p class="empty">
      Event details coming soon. Check back shortly, or follow the Independence
      Downtown Association for updates.
    </p>
  ) : (
    <ol class="days" style={`--wide-columns: ${wideColumns}`} data-columns={wideColumns}>
      {days.map((day, dayIndex) => (
        <li class="day">
          {dayIndex > 0 && (
            <span class="day__divider" aria-hidden="true">
              <Sparkle />
            </span>
          )}
          <div class="day__date">
            <SunDate date={day.date} />
            <p class="day__weekday" aria-hidden="true">{formatWeekday(day.date)}</p>
          </div>
          <ol class="day__events">
            {day.events.map((entry, index) => {
              const {
                name,
                location,
                cost,
                highlight,
                timeText,
                description,
                link,
                buttonText,
                icon,
              } = entry.data;
              const start = clockParts(entry.data.start);
              const end = clockParts(entry.data.end);
              // Keep the location's last word with "• FREE" so the cost never
              // wraps onto a line of its own.
              const locationWords = location.trim().split(/\s+/);
              const locationLast = locationWords.pop() ?? '';
              const locationStart = locationWords.join(' ');
              return (
                <li class="event">
                  {index > 0 && <Sparkle />}
                  {icon && <EventIcon name={icon} />}
                  <h3 class="event__name">
                    {splitLinkingWords(name, ['and']).map((piece) =>
                      piece.script ? (
                        <span class="event__and">{piece.text.trim()}</span>
                      ) : (
                        <span>{piece.text}</span>
                      ),
                    )}
                  </h3>
                  {highlight && <p class="event__highlight">{highlight}</p>}
                  <p class="event__place">
                    {cost ? (
                      <>
                        {locationStart && `${locationStart} `}
                        <span class="event__cost">
                          {locationLast}
                          <span aria-hidden="true"> • </span>
                          <span class="visually-hidden">, </span>
                          {cost}
                        </span>
                      </>
                    ) : (
                      location
                    )}
                  </p>
                  <p class="event__time">
                    {timeText ? (
                      splitLinkingWords(timeText).map((piece) =>
                        piece.script ? (
                          <span class="event__to">{piece.text}</span>
                        ) : (
                          <span>{piece.text}</span>
                        ),
                      )
                    ) : (
                      <>
                        {start.time}
                        <span class="event__mer">{start.meridiem}</span>
                        <span class="event__to"> to </span>
                        {end.time}
                        <span class="event__mer">{end.meridiem}</span>
                      </>
                    )}
                  </p>
                  {description && <p class="event__description">{description}</p>}
                  {link ? (
                    <p class="event__action">
                      <a
                        class="button"
                        href={link}
                        aria-label={`${buttonText ?? 'More details'}: ${name}`}
                      >
                        {buttonText ?? 'More details'}
                      </a>
                    </p>
                  ) : (
                    buttonText && (
                      <p class="event__action">
                        <span class="button button--placeholder">{buttonText}</span>
                      </p>
                    )
                  )}
                </li>
              );
            })}
          </ol>
        </li>
      ))}
    </ol>
  )
}

<style>
  .empty {
    margin: 0;
    padding: var(--space-6);
    border: var(--border-hairline) dashed var(--color-surface-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-strong);
    text-align: center;
    color: var(--color-text);
  }

  .days {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- Phone: one day after another ---- */
  .day {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding-block: var(--space-10);
    text-align: center;
  }

  .day:first-child {
    padding-top: 0;
  }

  .day + .day {
    border-top: var(--border-hairline) solid var(--color-rule-strong);
  }

  /* A gold sparkle sitting on the line between two days. */
  .day__divider {
    position: absolute;
    top: 0;
    left: 50%;
    padding-inline: var(--space-3);
    background: var(--color-bg);
    translate: -50% -50%;
  }

  .day__divider :global(.sparkle) {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* "SATURDAY" under the date circle. */
  .day__weekday {
    margin: var(--space-2) 0 0;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-eyebrow);
  }

  .day__events {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .event > :global(.sparkle) {
    margin-bottom: var(--space-3);
  }

  .event > :global(.icon) {
    margin-bottom: var(--space-1);
  }

  /* ---- Half screen: one row per day, date on the left ---- */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .day {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-8);
      text-align: left;
    }

    .day__divider {
      left: 4.5rem;
    }

    .event {
      justify-items: start;
    }

    .event > :global(.sparkle),
    .event > :global(.icon) {
      margin-inline: 0;
    }
  }

  /* ---- Full screen: days side by side, like the flyer's columns ---- */
  @media (min-width: 64rem) {
    .days {
      grid-template-columns: repeat(var(--wide-columns), minmax(0, 1fr));
      row-gap: var(--space-12);
    }

    .day {
      padding: 0 var(--space-4);
    }

    .day + .day {
      border-top: 0;
      border-left: var(--border-hairline) solid var(--color-rule-strong);
    }

    .days[data-columns='4'] .day:nth-child(4n + 1) {
      border-left: 0;
    }

    .day__divider {
      display: none;
    }
  }

  .event__name {
    margin: 0;
    font-size: var(--text-xl);
    text-transform: uppercase;
  }

  .event__and {
    display: block;
    font-family: var(--font-script);
    font-weight: var(--weight-medium);
    font-size: 0.8em;
    text-transform: none;
    line-height: 1;
  }

  .event__highlight {
    margin: 0;
    font-family: var(--font-slanted);
    font-style: italic;
    font-weight: var(--weight-light);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .event__place {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  /* Keep "• FREE" together so the dot never starts a line on its own. */
  .event__cost {
    white-space: nowrap;
  }

  .event__time {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .event__mer {
    font-size: 0.72em;
  }

  .event__to {
    font-family: var(--font-script);
    font-weight: var(--weight-medium);
    font-size: 0.8em;
    text-transform: none;
  }

  .event__description {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    /* Editors write multi paragraph descriptions in Pages CMS. Keep the line
     * breaks they typed instead of running it all together. */
    white-space: pre-line;
  }

  .event__action {
    margin: var(--space-2) 0 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
