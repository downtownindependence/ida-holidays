---
/*
 * The Holiday Window Display Contest. What shows depends on the "Window
 * contest stage" dropdown in Pages CMS; nothing switches automatically.
 *
 *   Coming soon    When voting opens, the business sign-up box (with the
 *                  prize amounts and sign-up form), list of entered windows
 *   Voting open    The ballot: business cards to pick, then email and submit
 *   Voting closed  When winners will be announced
 *   Winners        The top three, with photos when provided
 */
import type { HolidaySettings } from '../lib/settings';
import { PRIZES } from '../lib/settings';
import { buildVoteUrl, formatPlainDate, toBallotUrl } from '../lib/format';
import { parseBallotConfig } from '../lib/ballot';
import { parseSignupConfig } from '../lib/signup';
import Ballot from './Ballot.astro';
import SignupForm from './SignupForm.astro';

interface Props {
  settings: HolidaySettings;
}

const { settings } = Astro.props;
const {
  contestStage,
  businessSignupUrl,
  signupDeadline,
  votingOpens,
  votingDeadline,
  winnersAnnounced,
  decorationsThrough,
  votingFormUrl,
  participatingBusinesses,
  winners,
} = settings;

const ballotUrl = toBallotUrl(votingFormUrl);
const businessNames = participatingBusinesses.map((business) => business.name);
const opensText = votingOpens ? formatPlainDate(votingOpens, 'weekday') : null;
const deadlineText = votingDeadline ? formatPlainDate(votingDeadline, 'weekday') : null;
const signupText = signupDeadline ? formatPlainDate(signupDeadline, 'weekday') : null;
// "Voting runs Nov 28 through Dec 31. Winners announced the first week of
// January. Decorations stay up through January 1." All three come from Pages CMS.
const runsText =
  votingOpens && votingDeadline
    ? `Voting runs ${formatPlainDate(votingOpens, 'short')} through ${formatPlainDate(votingDeadline, 'short')}.`
    : null;
const announcedLine = winnersAnnounced ? `Winners announced the ${winnersAnnounced}.` : null;
const decorationsLine = decorationsThrough
  ? `Decorations stay up through ${formatPlainDate(decorationsThrough, 'monthDay')}.`
  : null;
const keyDates = [runsText, announcedLine, decorationsLine].filter(Boolean);
const sortedWinners = [...winners].sort((a, b) => a.place - b.place);
const placeNames = ['1st place', '2nd place', '3rd place'];
const isVoting = contestStage === 'voting-open';
// The ballot built into the page needs a correctly made pre-filled link (see
// src/lib/ballot.ts). Without one, the cards fall back to buttons that open
// the Google Form.
const ballotConfig = parseBallotConfig(votingFormUrl);
const onSiteBallot = isVoting && ballotConfig !== null && participatingBusinesses.length > 0;
// Same idea for the business sign-up: built into the page when the CMS link
// is a correctly made pre-filled link, otherwise a button to the Google Form.
const signupConfig = parseSignupConfig(businessSignupUrl);
---

<div class="contest">
  <p class="contest__lead">
    Downtown shops dress their windows for the season, and you pick the
    favorites. Stroll downtown, see what the businesses have put together, and
    vote for up to three.
  </p>

  <p class="contest__prizes">
    The three windows with the most votes win cash prizes for the business and
    a shout-out in the IDA newsletter.
  </p>

  {
    keyDates.length > 0 && contestStage !== 'winners' && (
      <ul class="dates" aria-label="Key dates">
        {keyDates.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    )
  }

  {
    contestStage === 'coming-soon' && (
      <div class="stage">
        <p class="stage__headline">
          {opensText ? `Voting opens ${opensText}` : 'Voting opens soon'}
        </p>
        <p class="stage__text">
          Come back here once the windows are up and the ballot is open.
        </p>
      </div>
    )
  }

  {
    contestStage === 'coming-soon' && (
      <div class="signup" id="signup">
        <p class="signup__eyebrow">For downtown businesses · Free to enter</p>
        <h3 class="signup__title">Enter your window &amp; win cash</h3>
        <p class="signup__text">
          Decorate your storefront window for the season and sign up to be on
          the ballot. The top three windows win:
        </p>
        <ul class="prizes" aria-label="Prizes">
          {PRIZES.map((prize, index) => (
            <li class="prize">
              <span class="prize__amount">{prize}</span>
              <span class="prize__place">{placeNames[index]}</span>
            </li>
          ))}
        </ul>
        <p class="signup__text">
          Plus a special shout-out in the IDA newsletter, read by about 1,500
          locals.
          {signupText && (
            <>
              {' '}
              Sign up by <strong>{signupText}</strong>.
            </>
          )}
        </p>
        {keyDates.length > 0 && <p class="signup__text signup__dates">{keyDates.join(' ')}</p>}
        {signupConfig ? (
          <SignupForm config={signupConfig} opensText={opensText} />
        ) : businessSignupUrl ? (
          <p class="signup__action">
            <a class="button button--red" href={businessSignupUrl}>
              Sign up your business
            </a>
          </p>
        ) : (
          <p class="signup__text">The sign-up form will be posted here shortly.</p>
        )}
      </div>
    )
  }

  {
    isVoting && !onSiteBallot && (
      <div class="stage stage--open">
        <p class="stage__headline">Voting is open</p>
        <p class="stage__text">
          Pick up to three favorite windows.
          {deadlineText && (
            <>
              {' '}
              Vote by <strong>{deadlineText}</strong>.
            </>
          )}
        </p>
        <p class="stage__fineprint">
          One ballot per email address. Duplicates are removed before counting.
        </p>
        {onSiteBallot ? null : ballotUrl ? (
          <p class="stage__action">
            <a class="button" href={ballotUrl}>
              Open the ballot
            </a>
          </p>
        ) : (
          <p class="stage__text">The ballot is being added. Check back shortly.</p>
        )}
      </div>
    )
  }

  {
    contestStage === 'voting-closed' && (
      <div class="stage">
        <p class="stage__headline">Voting is closed</p>
        <p class="stage__text">
          {winnersAnnounced
            ? `Thank you for voting! Winners will be announced the ${winnersAnnounced}.`
            : 'Thank you for voting! Winners will be announced soon.'}
        </p>
      </div>
    )
  }

  {
    contestStage === 'winners' &&
      (sortedWinners.length > 0 ? (
        <div class="winners">
          <p class="stage__headline">And the winners are</p>
          <ol class="winners__list">
            {sortedWinners.map((winner) => (
              <li class="winner">
                {winner.photo && (
                  <img
                    class="winner__photo"
                    src={winner.photo}
                    alt={`The winning window display at ${winner.business}`}
                    loading="lazy"
                  />
                )}
                <div class="winner__body">
                  <p class="winner__place">
                    {placeNames[winner.place - 1]} · {PRIZES[winner.place - 1]}
                  </p>
                  <p class="winner__business">{winner.business}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <div class="stage">
          <p class="stage__headline">Winners coming shortly</p>
          <p class="stage__text">The results are being finalized. Check back soon.</p>
        </div>
      ))
  }

  {
    onSiteBallot && ballotConfig && (
      <Ballot
        businesses={participatingBusinesses}
        config={ballotConfig}
        deadlineText={deadlineText}
      />
    )
  }

  {
    !onSiteBallot && participatingBusinesses.length > 0 && contestStage !== 'winners' && (
      <div class="windows" id="ballot">
        <h3 class="windows__title">
          {isVoting ? 'The ballot: participating windows' : 'Participating windows'}
        </h3>
        <p class="windows__note">
          {isVoting
            ? 'Tap a window to vote for it. You can pick up to three on the ballot.'
            : 'Plan your window walk.'}
        </p>
        <ul class="cards">
          {participatingBusinesses.map((business) => {
            const voteUrl = isVoting
              ? buildVoteUrl(votingFormUrl, business.name, businessNames)
              : null;
            return (
              <li class="card">
                {business.photo && (
                  <img
                    class="card__photo"
                    src={business.photo}
                    alt={`The holiday window at ${business.name}`}
                    loading="lazy"
                  />
                )}
                <div class="card__body">
                  <p class="card__name">{business.name}</p>
                  {business.address && <p class="card__address">{business.address}</p>}
                  {business.link && (
                    <p class="card__link">
                      <a href={business.link}>Visit their page</a>
                    </p>
                  )}
                  {voteUrl && (
                    <p class="card__action">
                      <a
                        class="button button--red"
                        href={voteUrl}
                        aria-label={`Vote for the window at ${business.name}`}
                      >
                        Vote for this window
                      </a>
                    </p>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</div>

<style>
  .contest {
    display: grid;
    gap: var(--space-8);
  }

  .contest__lead {
    margin: 0;
    text-align: center;
  }

  .contest__prizes {
    margin: 0;
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* Prize tiles inside the red business box. */
  .prizes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 26rem;
    margin: var(--space-4) auto;
    padding: 0;
    list-style: none;
  }

  .prize {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-sun);
    color: var(--color-accent-secondary);
    text-align: center;
  }

  .prize__amount {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .prize__place {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* The key dates, as a short centered list. */
  .dates {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .signup__dates {
    font-weight: var(--weight-semibold);
  }

  .stage {
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-surface-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .stage__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .stage__text {
    margin: var(--space-3) 0 0;
  }

  .stage__text strong,
  .signup__text strong {
    color: var(--color-heading);
  }

  .stage__fineprint {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .stage__action {
    margin: var(--space-5) 0 0;
  }

  /* The red box, like the flyer's "Vote for your favorite" banner. */
  .signup {
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-accent-secondary);
    color: var(--color-accent-secondary-contrast);
    text-align: center;
  }

  .signup__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .signup__title {
    margin: 0;
    font-family: var(--font-slanted);
    font-style: italic;
    font-weight: var(--weight-light);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: inherit;
  }

  .signup__text {
    margin: var(--space-3) auto 0;
    max-width: 30rem;
  }

  .signup__text strong {
    color: inherit;
  }

  .signup__action {
    margin: var(--space-5) 0 0;
  }

  /* On the red box the red button would disappear, so it turns cream. */
  .signup .button--red {
    background: var(--color-sun);
    color: var(--color-accent-secondary);
  }

  .signup .button--red:hover {
    background: var(--color-heading);
    color: var(--color-accent-secondary);
    filter: brightness(0.95);
  }

  .windows {
    scroll-margin-top: var(--space-6);
  }

  .windows__title {
    margin: 0;
    font-size: var(--text-xl);
    text-align: center;
    text-transform: uppercase;
  }

  .windows__note {
    margin: var(--space-2) 0 var(--space-5);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    border: var(--border-hairline) solid var(--color-surface-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-5);
    text-align: center;
  }

  .card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .card__address {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .card__link {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .card__action {
    margin: var(--space-3) 0 0;
  }

  .winners {
    text-align: center;
  }

  .winners__list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .winner {
    overflow: hidden;
    border: var(--border-hairline) solid var(--color-surface-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .winner__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .winner__body {
    padding: var(--space-5) var(--space-6);
  }

  .winner__place {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .winner__business {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-transform: uppercase;
    color: var(--color-heading);
  }
</style>
