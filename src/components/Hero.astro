---
/*
 * The "Season of lights" headline is Courtney's own lettering, cut out of the
 * flyer as a picture with a see-through background. The flyer's script font
 * is a paid font, and a picture keeps every swash exactly as she drew it.
 */
interface Props {
  /** For example "Every Saturday". */
  datelineTop: string;
  /** For example "Nov 28". */
  datelineFrom: string;
  /** For example "Dec 19". */
  datelineTo: string;
  /** Smaller header while voting is open, so the ballot shows sooner on a phone. */
  compact?: boolean;
}

const { datelineTop, datelineFrom, datelineTo, compact = false } = Astro.props;
---

<header class:list={['hero', compact && 'hero--compact']}>
  <div class="hero__inner">
    <a class="hero__logo" href="https://downtownindependence.com">
      <img
        src="/images/ida-logo.webp"
        alt="Independence Downtown Association"
        width="480"
        height="421"
      />
    </a>
    <p class="hero__eyebrow">Downtown Independence</p>
    <h1 class="hero__title">
      <img
        src="/images/season-of-lights.webp"
        alt="Season of Lights"
        width="1200"
        height="645"
        fetchpriority="high"
      />
    </h1>
    <p class="hero__dateline">
      <span>{datelineTop}</span>
      <span>{datelineFrom} <span class="hero__to">to</span> {datelineTo}</span>
    </p>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(var(--space-8), 6vw, var(--space-16)) var(--space-8);
    padding-inline: var(--page-gutter);
    text-align: center;
  }

  .hero--compact {
    padding-block: var(--space-6);
  }

  .hero--compact .hero__inner {
    max-width: 24rem;
  }

  .hero--compact .hero__logo {
    width: 3.5rem;
    margin-bottom: var(--space-3);
  }

  .hero--compact .hero__dateline {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
  }

  .hero__inner {
    max-width: var(--hero-max);
    margin-inline: auto;
  }

  .hero__logo {
    display: block;
    width: 5rem;
    margin: 0 auto var(--space-5);
  }

  .hero__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .hero__title {
    margin: 0;
  }

  .hero__title img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Slanted like the flyer, where it sits tucked beside "lights". */
  .hero__dateline {
    display: grid;
    justify-content: center;
    margin: var(--space-6) 0 0;
    font-family: var(--font-slanted);
    font-style: italic;
    font-weight: var(--weight-light);
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
    transform: rotate(-6deg);
  }

  .hero__to {
    font-family: var(--font-script);
    font-style: normal;
    font-weight: var(--weight-medium);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.85em;
  }
</style>
